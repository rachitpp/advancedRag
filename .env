# =============================================================
# CRAG Pipeline — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# Lines marked [REQUIRED] will crash at startup if missing.
# Lines marked [OPTIONAL] have sensible defaults — uncomment to override.
# =============================================================


# ---- GCP / Vertex AI ------------------------------------------------

# [REQUIRED] Your Google Cloud project ID
GOOGLE_CLOUD_PROJECT=my-gcp-project-123

# [OPTIONAL] Vertex AI region (default: us-central1)
# Other options: europe-west1, asia-southeast1, etc.
# GCP_LOCATION=us-central1


# ---- GCP Authentication ---------------------------------------------

# [REQUIRED if running locally] Path to your service account JSON key.
# Not needed on GCP VMs / Cloud Run (uses default service account).
# Alternative: run `gcloud auth application-default login` instead.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json


# ---- Models ----------------------------------------------------------

# [OPTIONAL] Main model for answer generation + structured output
# CRAG_MAIN_MODEL=gemini-2.5-pro

# [OPTIONAL] Fast model for grading, classification, claim verification
# CRAG_FAST_MODEL=gemini-2.5-flash

# [OPTIONAL] Generation temperature for the main model (0.0–1.0)
# CRAG_LLM_TEMPERATURE=0.1


# ---- Retrieval -------------------------------------------------------

# [OPTIONAL] Path to your ChromaDB directory
# Must be populated first — run your ingest/db_creation script before starting.
# CRAG_CHROMA_DIR=./chroma_db

# [OPTIONAL] Enable/disable HyDE (Hypothetical Document Embeddings)
# When true, conceptual and procedural queries get a HyDE passage for
# better vector recall. Factual queries always skip HyDE regardless.
# CRAG_HYDE_ENABLED=true


# ---- Web Search (Tavily) --------------------------------------------

# [REQUIRED] Tavily API key for web search fallback
# Get one at: https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---- LangSmith Tracing (Optional) -----------------------------------

# Enables detailed trace visualization for debugging and evaluation.
# Sign up at: https://smith.langchain.com
# Without these, the pipeline runs identically — you just lose the trace UI.

# LANGSMITH_API_KEY=lsv2-pt-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=crag-production
